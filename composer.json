{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "type": "project",
    "repositories": [
        {
            "type": "path",
            "url": "packages/laravelcollective-html"
        },
        {
            "type": "path",
            "url": "packages/laravel-paystack"
        }
    ],
    "require": {
        "php": "^8.2",
        "aloha/twilio": "^4.0|^5.0",
        "arcanedev/log-viewer": "~12.0",        "automattic/woocommerce": "^3.0",
        "barryvdh/laravel-dompdf": "^2.0|^3.0",
        "consoletvs/charts": "^6.0|^7.0",
        "giggsey/libphonenumber-for-php": "^8.12",
        "knox/pesapal": "^1.3|^2.0",
        "laravel/framework": "^12.0",
        "laravel/passport": "^12.0",
        "laravel/ui": "^4.0",
        "laravel/tinker": "^2.8",
        "laravelcollective/html": "*",
        "maatwebsite/excel": "^3.1",
        "milon/barcode": "^10.0|^11.0|^12.0|^13.0",
        "mpdf/mpdf": "^8.0",
        "vonage/client": "^4.0|^5.0",
        "nwidart/laravel-modules": "^12.0|^13.0",
        "pusher/pusher-php-server": "^7.0",
        "razorpay/razorpay": "^2.0",
        "spatie/flysystem-dropbox": "^3.0",
        "spatie/laravel-activitylog": "^4.7|^5.0",
        "spatie/laravel-backup": "^8.0|^9.0",
        "spatie/laravel-permission": "^5.10|^6.0",
        "srmklive/paypal": "^3.0",
        "stripe/stripe-php": "^10.0|^13.0",
        "unicodeveloper/laravel-paystack": "*",
        "yajra/laravel-datatables-oracle": "^12.0|^13.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.9",
        "beyondcode/laravel-dump-server": "^2.0",
        "fakerphp/faker": "^1.23",
        "filp/whoops": "^2.14",
        "mockery/mockery": "^1.5",
        "nunomaduro/collision": "^8.0|^9.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "files": [
            "app/Http/helpers.php"
        ],
        "classmap": [
            "database"
        ],
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "Modules/",
            "Nwidart\\Menus\\": "app/Support/Menus/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-install-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "ocramius/package-versions": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
